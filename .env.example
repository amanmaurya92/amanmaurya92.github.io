# Server
PORT=5000
NODE_ENV=development

# CORS: comma-separated origins (optional; localhost allowed by default)
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_USER.github.io

# Optional: contact form email (e.g. Gmail app password)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: GET /api/contact list — require header x-admin-key
ADMIN_API_KEY=
