# Server (Render, Railway, VPS, or local)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/portfolio

# CORS: your GitHub Pages URL(s), comma-separated
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_USER.github.io,https://YOUR_USER.github.io/YOUR_REPO

# Optional: contact email (Gmail app password recommended)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Optional: protect GET /api/contact (list messages)
ADMIN_API_KEY=
